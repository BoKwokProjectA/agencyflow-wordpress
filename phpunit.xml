<?xml version="1.0" encoding="UTF-8"?>
<!-- PHPUnit configuration for the helper test suite. -->
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    failOnWarning="true"
    failOnRisky="true">
    <testsuites>
        <testsuite name="AgencyFlow helpers">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
